{
  "name": "quebec-sante-cli",
  "version": "0.1.0",
  "description": "Deterministic CLI for Québec health-services open data from MSSS: ER occupancy and history, clinic appointment availability, fiscal-year ER indicators and surgical waitlists",
  "type": "commonjs",
  "bin": {
    "msss-urgences": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "msss",
    "quebec",
    "urgences",
    "emergency-room",
    "cli",
    "open-data"
  ],
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

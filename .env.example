# Directory where the CLI stores its local data cache (single parsed-JSON file.
# Cache validity is a wall-clock TTL on when it was written, default 30 min).
# Defaults to ~/.cache/msss-urgences when unset.
MSSS_URGENCES_CACHE_DIR=

# urgences-historique: base URL of the static history API (default: this repo's
# GitHub Pages, https://krystosterone.github.io/quebec-sante-cli/api/v1).
MSSS_URGENCES_API_URL=
# urgences-historique: read a local API directory (with index.json) instead of
# the network, e.g. one built by `npx tsx scripts/build-api.ts site` (use site/api/v1).
MSSS_URGENCES_API_FIXTURE=
